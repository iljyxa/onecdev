# vsce не читает .gitignore: локальные каталоги из него (настройки IDE, справочные выгрузки)
# исключаются здесь явно, иначе при наличии у разработчика они попадут в VSIX.
.vscode/**
example2/**
.cursor/**
.codex/**

.vscode-test/**
out/**
node_modules/**
example/**
docs/**
**/*.log
.gitignore
tsconfig.json
tsconfig.*.json
vite*.config.ts
vite.shared.ts
src-ui/**
scripts/**
**/*.map
# Служебные фрагменты сборки THIRD_PARTY_LICENSES; сам dist/THIRD_PARTY_LICENSES.txt идёт в VSIX.
dist/third-party/**
**/*.ts
src/test/**
coverage/**
.claude/**
.github/**
CLAUDE.md
eslint.config.mjs
.c8rc.json
